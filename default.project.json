        "RequestRestart": {
          "$className": "RemoteEvent"
        },
        "RunState": {
          "$className": "RemoteEvent"
        },
        "RequestExit": {
          "$className": "RemoteEvent"
        },
        "RequestEnter": {
          "$className": "RemoteEvent"
        },
        "ReportCrash": {
          "$className": "RemoteEvent"
        },
        "DevTuning": {
          "$className": "RemoteEvent"
        }
      }
    },

    "ServerScriptService": {
